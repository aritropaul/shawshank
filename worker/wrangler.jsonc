{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tunnel",
  "main": "src/index.ts",
  // Fonts for the error pages, bundled as binary modules.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["TOKEN"] },
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true },
  // Per-IP limits, counted per Cloudflare location. Visitors: generous enough
  // for a dev server's cold load. Logins: guesses at a tunnel's password.
  // Probes: lookups of tunnel names not recently seen live (name scanning).
  // namespace_id is account-wide: pick unused numbers if you have other limiters.
  "ratelimits": [
    { "name": "VISITORS", "namespace_id": "8471001", "simple": { "limit": 1000, "period": 10 } },
    { "name": "CONNECTS", "namespace_id": "8471002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LOGINS", "namespace_id": "8471003", "simple": { "limit": 60, "period": 60 } },
    { "name": "PROBES", "namespace_id": "8471004", "simple": { "limit": 300, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL", "class_name": "Tunnel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tunnel"] }]
}
